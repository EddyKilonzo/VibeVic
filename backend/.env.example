# Copy to .env and fill in locally. .env is gitignored and must stay that way:
# this file is the only one that is ever committed, and it must never contain a
# real credential — every value below is a placeholder, not a working secret.

NODE_ENV=development
PORT=4000

# Postgres. Use a database that holds nothing but local test structures until
# the privacy boundary has been reviewed (see README, "Not safe to expose yet").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vibevic?schema=public"

# Comma-separated list. Empty means no browser origin is allowed.
CORS_ORIGINS=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────────────────
# disabled | dev | jwt
#
#   disabled  Newsroom routes answer 501. Nothing private is reachable. This is
#             the default precisely because a scaffold that ships an open
#             newsroom is worse than one that ships a closed door.
#   dev       Single hard-coded local principal, authenticated by the token
#             below. Refuses to boot when NODE_ENV=production. Never granted the
#             confidential scope — confidential material is not reachable in a
#             mode that exists for convenience.
#   jwt       Verifies bearer tokens with AUTH_JWT_SECRET. There is no issuer
#             yet (see AuthService.issueToken), so nothing mints these.
AUTH_MODE=disabled

# Required when AUTH_MODE=jwt. Generate your own; do not reuse this line.
# e.g. openssl rand -base64 48
AUTH_JWT_SECRET=

# Required when AUTH_MODE=dev. Any locally generated random string of 16+ chars.
DEV_PRINCIPAL_TOKEN=
DEV_PRINCIPAL_EMAIL=journalist@localhost
