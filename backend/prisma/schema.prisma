// VibeVic data model.
//
// Two halves that must not be confused with one another:
//
//   * Public content — Story, Genre, Publication, Award. Mirrors
//     frontend/app/src/data/types.ts. Readable without authentication.
//   * The newsroom — everything behind a published story. Mirrors
//     frontend/app/src/data/newsroom/types.ts. Never readable without
//     authentication, and never serialisable onto a public response.
//
// Visibility is a property of the record, not of the screen showing it, so it
// lives on the table. `CONFIDENTIAL` is stronger than `PRIVATE`: for those rows
// even the *existence* of the record is protected, which is why the read path
// filters them out of queries rather than fetching and then hiding them (see
// AccessPolicyService.visibilityFilter). A 403 on a confidential id would
// confirm the id exists; the API returns 404 instead.
//
// Every table carries createdAt/updatedAt. updatedAt is not decoration: it is
// the optimistic-concurrency token. Postgres timestamps here are millisecond
// precision (Prisma's default `timestamp(3)`), which matches the ISO strings
// the client round-trips, so an equality check on it is exact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled, for the running server: Neon's PgBouncer hands out a connection
  // per transaction rather than holding one open per process.
  url       = env("DATABASE_URL")
  // Unpooled, for migrations only. DDL runs inside advisory locks and
  // session-scoped statements that a transaction-mode pooler cannot carry, so
  // a migration aimed at the pooler fails in ways that read as network trouble.
  directUrl = env("DIRECT_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum Visibility {
  CONFIDENTIAL
  PRIVATE
  PUBLISHABLE
}

enum StoryStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum IdeaStage {
  SPARK
  RESEARCHING
  PITCHED
  COMMISSIONED
  DROPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum SourceStatus {
  UNVERIFIED
  VERIFYING
  VERIFIED
  DISPUTED
}

enum EntityKind {
  PERSON
  ORGANISATION
  LOCATION
  PROJECT
  DOCUMENT
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaSource {
  /// Bytes we hold, stored in Cloudinary.
  UPLOAD
  /// Hosted by someone else; we keep the address and nothing more.
  LINK
}

/// What a reader did with a story. Three kinds, and no fourth without a reason:
/// every kind is a separate row per reader-session per day, so adding one adds
/// a way to be counted.
enum ReadEventKind {
  /// The article was opened.
  VIEW
  /// The reader reached the end of it.
  READ
  /// It was played through the voice player.
  LISTEN
}

enum PortfolioClass {
  STANDARD
  SIGNATURE
  INVESTIGATION
  AWARD_SUBMISSION
}

// ── Accounts ────────────────────────────────────────────────────────────

/// What someone is here to do, and therefore what they may see.
///
/// Two roles, because there are two jobs and they are genuinely different —
/// not two rungs of one ladder. The split that matters is
/// `newsroom:confidential`, and it does not run the way seniority would
/// suggest:
///
///   * WRITER is the journalist. She holds every scope, confidential
///     included, because protecting a source and knowing who that source is
///     are the same act. Withholding it from her would not protect anybody;
///     it would only stop the newsroom from being used for reporting.
///
///   * DEV maintains the software. That job needs to read and write records,
///     reproduce a bug, and check a migration — none of which needs the name
///     behind a pseudonym. So the account that a laptop, a CI run and a
///     support session all touch is the one that cannot expose an identity,
///     and the blast radius of losing it stops short of a source.
///
/// This is the same argument `DEV_PRINCIPAL_CONFIDENTIAL` makes about the
/// dev auth mode, now written into the schema rather than an env var.
enum Role {
  WRITER
  DEV
}

/// An account that can sign in.
///
/// Scopes used to live here as a string array with a note calling it a
/// scaffold. They are derived from `role` now (see `modules/auth/roles.ts`),
/// which means a permission cannot be edited onto one row by hand: changing
/// what a writer may do is a code change that shows up in a diff, not an
/// UPDATE somebody ran once and nobody reviewed.
model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  Role   @default(WRITER)

  /// argon2id, or null.
  ///
  /// Null is a real state and not a defect: an account is created before its
  /// owner has chosen a password, and until they do it can request a reset
  /// link but cannot log in. Making the column non-null would have forced a
  /// placeholder hash, and a placeholder that happens to be guessable is a
  /// login. Null cannot be guessed.
  passwordHash String?

  /// Sessions issued before this instant are refused.
  ///
  /// The revocation the old auth module said it did not have. A JWT cannot be
  /// withdrawn once signed, so this moves forward whenever the password
  /// changes and every token older than it stops verifying — which is what
  /// "I think someone has my password" has to mean to be worth saying.
  tokensValidFrom DateTime @default(now())

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  passwordResets PasswordReset[]

  @@map("users")
}

/// One outstanding "email me a way back in".
///
/// The token that was emailed is not in this table. What is stored is its
/// SHA-256, so a dump of this table — a backup, a support query, a log of a
/// slow statement — cannot be replayed into somebody's account. The row is
/// the receipt; the secret left in the email and is not kept anywhere else.
///
/// SHA-256 rather than argon2id, deliberately: this token is 256 bits of
/// `randomBytes`, so there is no dictionary to slow down and nothing for a
/// work factor to buy. Password hashing is slow because passwords are
/// guessable. This is not.
model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment it is spent. Single use is the whole point: a reset link
  /// sits in an inbox, and an inbox is not a place a reusable key belongs.
  usedAt    DateTime?

  /// The forwarded address that asked. Kept so a burst of requests against
  /// one account is visible afterwards, not to decide anything at the time.
  requestedFrom String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

// ── Public content ──────────────────────────────────────────────────────

model Story {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  /// Standfirst / deck.
  dek            String
  genreSlug      String
  tags           String[]    @default([])
  status         StoryStatus @default(DRAFT)
  publishedAt    DateTime?
  readingMinutes Int         @default(0)
  featured       Boolean     @default(false)
  /// Template text shipped with the site, not authored reporting. Rendered with
  /// a visible label so it can never be mistaken for published work.
  placeholder    Boolean     @default(false)
  /// Where it originally ran, if syndicated.
  publication    String?

  /// The piece at its original home, for imported work. A syndicated article
  /// should always be able to point at the version its author maintains: if the
  /// two diverge, a reader can see which is which instead of trusting this copy.
  sourceUrl String?

  /// A real cover photograph. Null means the site falls back to generated art
  /// keyed off the slug — deliberately abstract, so decoration standing in for a
  /// picture is never mistaken for one.
  cover String?

  /// Ordered list of typed blocks, stored as JSON rather than HTML so the
  /// editor can reorder blocks and the voice engine can pick which ones to
  /// read. The union is validated in the application layer (StoryBlockDto);
  /// a relational block table would buy nothing here and cost a join per read.
  body Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, not Cascade or SetNull: deleting a genre must never delete
  // published work, and genreSlug is required, so it cannot be nulled either.
  genre     Genre           @relation(fields: [genreSlug], references: [slug], onDelete: Restrict)
  stats     StoryStats?
  events    StoryEvent[]
  portfolio PortfolioEntry?

  ideas     Idea[]
  pitches   Pitch[]
  notes     Note[]
  deadlines Deadline[]
  revisions StoryRevision[]

  sources     StorySource[]
  quotes      StoryQuote[]
  interviews  StoryInterview[]
  evidence    StoryEvidence[]
  timeline    StoryTimelineEvent[]
  collections CollectionStory[]

  @@index([status, publishedAt])
  @@index([genreSlug])
  @@map("stories")
}

/// An earlier version of a story, kept so a paragraph can be got back.
///
/// ── What is stored, and what deliberately is not ─────────────────────────
/// The three fields a writer can lose work in: the headline, the standfirst
/// and the body. Not the beat, the tags, the cover or the slug — those are
/// filing rather than writing, they are changed deliberately rather than by
/// accident, and copying them in would mean restoring an old draft silently
/// re-filed the piece under an old beat.
///
/// ── Why a table and not a JSON column on Story ───────────────────────────
/// A history is a list, and a list in a column is a list that has to be read
/// and rewritten whole on every append — on a table whose row is already the
/// hot path for the editor. Rows also let the pruning below be one DELETE
/// rather than a read-modify-write race between two tabs.
///
/// ── There is no author column ────────────────────────────────────────────
/// There would be nothing honest to put in it. Two accounts can edit a draft
/// and the API knows which principal made the request, but the existing rows
/// predate this table and would have to be attributed to somebody. A column
/// that is right for new rows and a guess for old ones is worse than no
/// column: it reads as a fact.
model StoryRevision {
  id      String @id @default(cuid())
  storyId String

  title String
  dek   String
  body  Json

  /// The moment this version was *replaced*, which is what a reader of the
  /// list is looking for: "the copy as it stood until then".
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@map("story_revisions")
}

/// Split from Story so a public read never has to select around it, and so
/// counters can be written on a hot path without touching the article row.
model StoryStats {
  storyId          String   @id
  views            Int      @default(0)
  reads            Int      @default(0)
  /// Listens via the voice player.
  listens          Int      @default(0)
  avgListenSeconds Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_stats")
}

/// An append-only record of what readers did, and the ledger `StoryStats` is
/// derived from.
///
/// ── Why a table of events and not a counter ─────────────────────────────
/// `StoriesService.recordView` was left unimplemented on an argument worth
/// keeping: "Counters need de-duplication, bot filtering and a write path that
/// does not lock the article row on every page view; an increment here would
/// produce numbers nobody should quote." All three are answered here rather
/// than skipped.
///
/// De-duplication is the unique index: one row per story, per kind, per
/// reader-session, per day. Pressing reload twenty times counts once.
///
/// The write path never touches `stories`. It writes one narrow row keyed by
/// that index, so two readers on the same article never contend.
///
/// ── What `session` is, and what it is not ───────────────────────────────
/// A random string the browser mints per tab and keeps in `sessionStorage`. It
/// is not a cookie, it is not derived from an address or a device, it is never
/// read back out of this table, and it dies when the tab closes. It exists to
/// answer "is this the same visit" and cannot answer "who is this" — which is
/// the whole reason a journalism site can carry it.
model StoryEvent {
  id      String        @id @default(cuid())
  storyId String
  kind    ReadEventKind
  session String
  /// The UTC date as YYYY-MM-DD. A column rather than a function on
  /// `occurredAt` so it can carry the unique index above.
  day     String
  /// Seconds listened, accumulated across one session-day. Zero for VIEW/READ.
  seconds Int           @default(0)

  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, kind, session, day])
  @@index([storyId, kind])
  @@index([occurredAt])
  @@map("story_events")
}

/// The archive is two levels deep and no more: six beats a reader can hold in
/// their head, with the specific subjects filed underneath them. A story is
/// filed against exactly one slug — parent or child — and everything that counts
/// work under a parent walks the family rather than assuming stories sit on the
/// parent itself.
model Genre {
  slug        String   @id
  name        String
  description String
  /// Null for a top-level beat. A real foreign key rather than a loose string,
  /// so a child cannot be filed under a beat that does not exist.
  parentSlug  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: deleting a beat that still has subjects under it should fail
  // loudly, not orphan them or cascade away half the taxonomy.
  parent   Genre?  @relation("GenreTree", fields: [parentSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  children Genre[] @relation("GenreTree")

  stories Story[]

  @@index([parentSlug])
  @@map("genres")
}

model Publication {
  id          String   @id @default(cuid())
  name        String
  role        String
  period      String
  description String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("publications")
}

model Award {
  id          String   @id @default(cuid())
  year        String
  title       String
  body        String
  description String
  /// "Winner" | "Finalist" | "Shortlisted" | "Honourable mention".
  result      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("awards")
}

/// The media library.
///
/// Cloudinary holds the bytes; this table holds the record of them. Splitting it
/// that way is what makes the library survive a browser — it used to live in
/// IndexedDB, so a photograph uploaded on a laptop did not exist on a phone, and
/// clearing site data destroyed the only copy.
///
/// A LINK item has no `publicId`: it is hosted somewhere else and we store the
/// address, deliberately not a copy. Copying someone else's image into our
/// account would create a second version to drift and a licence question to
/// answer, and the admin is explicit that a link is a link.
model MediaAsset {
  id     String      @id @default(cuid())
  kind   MediaKind
  source MediaSource @default(UPLOAD)
  /// Filename, or the last path segment of a link. What the library shows.
  name   String
  /// Alternative text. Empty is allowed and is not the same as absent: the
  /// editor nags about it, and a decorative image legitimately has none.
  alt    String      @default("")

  /// Cloudinary public id, e.g. "vibevic/a3f9c1". Unique because it is the
  /// identity of the asset over there, and two rows pointing at one file would
  /// let a delete remove an image another row still believes it owns.
  publicId String? @unique
  /// Delivery address. Cloudinary's secure_url for an upload, the original
  /// address for a link.
  url      String
  /// Reported by Cloudinary at upload. Null on links, where we have not
  /// fetched the file and will not guess at it.
  bytes    Int?
  width    Int?
  height   Int?
  format   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([createdAt])
  @@map("media_assets")
}

// ── Curation ────────────────────────────────────────────────────────────

/// Collections and portfolio classes are the two pieces of newsroom state the
/// journalist chose to make visible, which is why they are the only ones the
/// public curation payload can carry (see toPublicNewsroomPayload).
model Collection {
  id           String   @id @default(cuid())
  title        String
  description  String
  coverStoryId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stories CollectionStory[]

  @@map("collections")
}

/// Ordered join — the order *is* the curation, so position is data, not a
/// display preference, and must survive a round trip.
model CollectionStory {
  collectionId String
  storyId      String
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  story      Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([collectionId, storyId])
  @@unique([collectionId, position])
  @@map("collection_stories")
}

/// How the journalist rates a piece — kept apart from StoryStats on purpose.
/// A signature investigation with modest traffic is still the signature
/// investigation, and merging the two would let traffic overwrite judgement.
model PortfolioEntry {
  storyId   String         @id
  class     PortfolioClass @default(STANDARD)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("portfolio_entries")
}

/// House style: preferred term → terms to avoid.
model StyleGuideEntry {
  id        String   @id @default(cuid())
  preferred String
  avoid     String[] @default([])
  why       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("style_guide_entries")
}

// ── Newsroom: ideas and pitches ─────────────────────────────────────────

/// Ideas and pitches carry no visibility column: the whole collection is
/// private, so there is no per-row decision to make and no column that could be
/// set to PUBLISHABLE by mistake.
model Idea {
  id        String    @id @default(cuid())
  title     String
  note      String    @default("")
  tags      String[]  @default([])
  genre     String
  /// The journalist's own ranking. Never computed — an invented priority score
  /// would be a machine pretending to know what matters.
  priority  Priority  @default(MEDIUM)
  stage     IdeaStage @default(SPARK)
  storyId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  story   Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)
  pitches Pitch[]

  @@index([stage])
  @@map("ideas")
}

model Pitch {
  id                String    @id @default(cuid())
  ideaId            String?
  title             String
  /// The specific angle, not the subject area.
  angle             String
  whyItMatters      String    @default("")
  whatIsKnown       String    @default("")
  whatIsUnknown     String    @default("")
  targetPublication String?
  deadline          DateTime?
  storyId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  idea    Idea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  story   Story?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  /// Sources stay a reference, never a copy: a pitch that inlined contact
  /// details would become a second place responsible for protecting them.
  sources PitchSource[]

  @@map("pitches")
}

model PitchSource {
  pitchId   String
  sourceId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pitch  Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([pitchId, sourceId])
  @@map("pitch_sources")
}

// ── Newsroom: sources, quotes, interviews ───────────────────────────────

model Source {
  id           String       @id @default(cuid())
  /// May be a pseudonym when visibility is CONFIDENTIAL.
  name         String
  role         String?
  organisation String?
  url          String?
  /// ISO date the URL was last actually opened — not a guess.
  accessedAt   DateTime?
  notes        String       @default("")
  status       SourceStatus @default(UNVERIFIED)
  visibility   Visibility   @default(CONFIDENTIAL)

  /// Real identity behind a pseudonym. Separate column so a screen, an export
  /// or a query can load the record without it; nothing in the serialisation
  /// layer will ever place this field on a response, public or not, without an
  /// explicit read of `Source.protectedIdentity` by name.
  protectedIdentity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories  StorySource[]
  quotes   Quote[]
  evidence EvidenceItem[]
  pitches  PitchSource[]

  @@index([visibility])
  @@map("sources")
}

model Quote {
  id          String       @id @default(cuid())
  text        String
  speaker     String
  speakerRole String?
  /// When it was said, which is not when it was written down.
  saidAt      DateTime?
  sourceId    String?
  interviewId String?
  /// Whether the interview counts this among its key quotes. Modelled as a
  /// flag rather than a second join table because a key quote is by definition
  /// one of that interview's quotes — a join could disagree with itself.
  keyQuote    Boolean      @default(false)
  status      SourceStatus @default(UNVERIFIED)
  visibility  Visibility   @default(PRIVATE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  source    Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  interview Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  stories   StoryQuote[]

  @@index([visibility])
  @@map("quotes")
}

model Interview {
  id          String     @id @default(cuid())
  interviewee String
  role        String?
  purpose     String     @default("")
  conductedAt DateTime?
  /// Free notes. Transcripts, if a recording is ever made, live here too.
  notes       String     @default("")
  /// Ordered list of open questions still to put to this interviewee.
  followUps   String[]   @default([])
  visibility  Visibility @default(CONFIDENTIAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  quotes  Quote[]
  stories StoryInterview[]

  @@index([visibility])
  @@map("interviews")
}

// ── Newsroom: evidence, entities, timeline ──────────────────────────────

model Entity {
  id         String     @id @default(cuid())
  kind       EntityKind
  name       String
  /// Other spellings and acronyms seen in the copy. A list rather than a single
  /// alias because the terminology check reads all of them.
  aliases    String[]   @default([])
  note       String     @default("")
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  evidence EvidenceEntity[]
  timeline TimelineEventEntity[]

  @@index([visibility])
  @@map("entities")
}

model EvidenceItem {
  id         String     @id @default(cuid())
  title      String
  /// What this actually demonstrates — the claim it supports.
  supports   String     @default("")
  sourceId   String?
  /// Free-text link or file reference. There is no upload pipeline, and a fake
  /// one would imply documents are stored here when they are not.
  reference  String?
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  source   Source?                 @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  entities EvidenceEntity[]
  stories  StoryEvidence[]
  timeline TimelineEventEvidence[]

  @@index([visibility])
  @@map("evidence_items")
}

model TimelineEvent {
  id         String   @id @default(cuid())
  /// The date of the event itself, not of the note about it.
  occurredAt DateTime
  what       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entities TimelineEventEntity[]
  evidence TimelineEventEvidence[]
  stories  StoryTimelineEvent[]

  @@index([occurredAt])
  @@map("timeline_events")
}

// ── Newsroom: working notes and deadlines ───────────────────────────────

model Note {
  id         String     @id @default(cuid())
  title      String
  body       String     @default("")
  storyId    String?
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([visibility])
  @@map("notes")
}

model Deadline {
  id        String   @id @default(cuid())
  storyId   String?
  label     String
  dueAt     DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@map("deadlines")
}

// ── Story ↔ record joins ────────────────────────────────────────────────
//
// Explicit join tables rather than implicit many-to-many. Two reasons that
// matter here: the link between a story and a confidential source is itself
// sensitive (it says who a story talked to), so it deserves a row that can be
// audited and deleted on its own; and an explicit table leaves room for the
// per-link fields this will grow — when the link was made, by whom.

model StorySource {
  storyId   String
  sourceId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([storyId, sourceId])
  @@map("story_sources")
}

model StoryQuote {
  storyId   String
  quoteId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@id([storyId, quoteId])
  @@map("story_quotes")
}

model StoryInterview {
  storyId     String
  interviewId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@id([storyId, interviewId])
  @@map("story_interviews")
}

model StoryEvidence {
  storyId    String
  evidenceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  story    Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  evidence EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([storyId, evidenceId])
  @@map("story_evidence")
}

model StoryTimelineEvent {
  storyId         String
  timelineEventId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  story         Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  timelineEvent TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)

  @@id([storyId, timelineEventId])
  @@map("story_timeline_events")
}

model EvidenceEntity {
  evidenceId String
  entityId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  evidence EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  entity   Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([evidenceId, entityId])
  @@map("evidence_entities")
}

model TimelineEventEntity {
  timelineEventId String
  entityId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timelineEvent TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  entity        Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([timelineEventId, entityId])
  @@map("timeline_event_entities")
}

model TimelineEventEvidence {
  timelineEventId String
  evidenceId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timelineEvent TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  evidence      EvidenceItem  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([timelineEventId, evidenceId])
  @@map("timeline_event_evidence")
}

/// A counter, shared by every instance of this API.
///
/// ── Why this is a table and not a Map ────────────────────────────────────
/// Both throttles used to live in their own process's memory, and both said
/// so: a deployment behind two instances handed out two full allowances, and
/// a restart cleared the count. That is a speed bump described as a control.
/// A row is the smallest thing that every instance can see and that a restart
/// does not forget.
///
/// ── Why the subject is hashed into the key ───────────────────────────────
/// The natural key is "the address someone tried to sign in as", and a table
/// of those is a list of addresses worth attacking — including, for a
/// newsroom, addresses that turn out to have accounts. The key is a SHA-256
/// of "<scope>:<subject>", so the table can count without holding the list.
/// Safe as a plain digest for the same reason `PasswordReset.tokenHash` is
/// not: this one is not a credential, it is an opaque bucket name, and it
/// never needs to be reversed.
///
/// ── Why there is no relation to User ─────────────────────────────────────
/// Most keys are not accounts. An address with no account has to be counted
/// exactly like one that has, or the difference between "throttled" and "not
/// throttled" becomes the enumeration oracle that every message in the auth
/// module is written to avoid.
model RateLimit {
  /// sha256("<scope>:<subject>"). Opaque on purpose — see above.
  key String @id

  /// Attempts inside the current window, including the one being counted.
  count Int

  /// When the current window opened. A hit after `windowAt + window` starts
  /// a new one rather than extending this.
  windowAt DateTime

  /// Last touched, for the sweep that clears rows nobody will read again.
  updatedAt DateTime

  @@index([updatedAt])
  @@map("rate_limits")
}
