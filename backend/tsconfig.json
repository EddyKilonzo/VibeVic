{
  "compilerOptions": {
    // node16 rather than commonjs + node10. The old pair still emits exactly
    // the same CommonJS here — package.json has no "type": "module" — but
    // node10 resolution is deprecated and becomes a hard error in TypeScript 7,
    // which is what the editor was flagging.
    "module": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node16",
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",

    // No "baseUrl", and no "paths" to go with it. Both were here for an
    // "@app/*" alias that nothing ever imported — `grep -rn "@app/"` across
    // src, prisma and the Nest config finds nothing. `baseUrl` is deprecated
    // and becomes a hard error in TypeScript 7, and the migration for dead
    // config is to delete it rather than to silence the warning with
    // "ignoreDeprecations". Relative imports are what this codebase actually
    // uses throughout.
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Strict on purpose. The privacy boundary in src/common/serialization is
    // type-driven: a public view is only trustworthy if the compiler refuses
    // the `any` that would let a newsroom record slip through it untyped.
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}
